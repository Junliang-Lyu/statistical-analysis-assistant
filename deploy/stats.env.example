# Server-only /opt/stats/.env.production, chmod 600. Never commit the populated file.
STATS_PUBLIC_ORIGIN=https://stats.jun-liang-lyu.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Must match DEEPSEEK_MODEL and be verified against its current provider prices.
# Use ceilings at least as high as peak uncached input/output prices; zero disables live mode.
STATS_PRICED_MODEL=deepseek-chat
STATS_INPUT_USD_PER_MILLION=0
STATS_OUTPUT_USD_PER_MILLION=0
STATS_DAILY_BUDGET_USD=0.5
STATS_MONTHLY_BUDGET_USD=5
STATS_PER_CLIENT_DAILY=10
STATS_GLOBAL_DAILY=100
